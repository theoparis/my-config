#!/bin/sh
set -e
cd /opt/discord-canary/resources

electron \
    --ignore-gpu-blocklist \
    --enable-features=VapiVideoDecoder,WebRTCPipeWireCapture,UseOzonePlatform \
    --use-gl=desktop \
    --ozone-platform=wayland \
    --enable--gpu \
    --enable-gpu-rasterization \
    --enable-zero-copy \
    app.asar
